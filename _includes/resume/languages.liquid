<div class="row languages-section">
  {% for content in data[1] %}
    <div class="col-md-6 mb-3">
      <div class="language-card d-flex flex-column justify-content-center">
        <div class="d-flex align-items-center mb-1">
          {% if content.icon %}
            <span class="language-icon mr-2">
              <i class="{{ content.icon }}"></i>
            </span>
          {% endif %}
          <span class="language-name font-weight-bold">
            {{ content.language }}
          </span>
        </div>
        <div class="language-fluency">
          <span class="language-tag">
            {{ content.fluency }}
          </span>
        </div>
      </div>
    </div>
  {% endfor %}
</div>

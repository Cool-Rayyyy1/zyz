<div class="row skills-section">
  {% for content in data[1] %}
    <div class="col-md-6 mb-3">
      <div class="skill-card" title="{{ content.level }}">
        <!-- 头部：图标 + 分类名 -->
        <div class="skill-card-header d-flex align-items-center mb-2">
          {% if content.icon %}
            <i class="{{ content.icon }} mr-2 skill-icon"></i>
          {% endif %}
          <span class="skill-category font-weight-bold">
            {{ content.name }}
          </span>
        </div>

        <!-- 技能标签 -->
        <div class="skill-tags">
          {% for item in content.keywords %}
            <span class="skill-tag">
              {{ item }}
            </span>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endfor %}
</div>


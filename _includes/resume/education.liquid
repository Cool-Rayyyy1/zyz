<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign education = data[1] | sort: 'startDate' | reverse %}
  {% for content in education %}
    <li class="list-group-item">
      <div class="row">

        <!-- 左列：跟 work 一样，用 cv-work-date-col 做竖直居中 -->
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center cv-work-date-col">

          {% if content.logo %}
            <div class="cv-edu-logo mb-2">
              <img src="{{ content.logo | relative_url }}" alt="{{ content.institution }} logo">
            </div>
          {% endif %}

          {% if content.startDate and content.startDate != '' %}
            {% assign startDate = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
            {% assign end_raw = content.endDate | default: '' %}

            {% if end_raw == '' %}
              {% assign date = startDate | append: ' - PRESENT' %}
            {% else %}
              {% assign endDate = end_raw | split: '-' | slice: 0, 2 | join: '.' %}
              {% assign date = startDate | append: ' - ' | append: endDate %}
            {% endif %}

            <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
              {{ date }}
            </span>
          {% endif %}

          {% if content.location %}
            <p class="location mt-1 mb-0">
              <i class="fa-solid fa-location-dot iconlocation"></i>
              {{ content.location }}
            </p>
          {% endif %}

        </div>

        <!-- 右列：学校信息，整列垂直居中 -->
        <div class="col-xs-10 cl-sm-10 col-md-10 d-flex flex-column justify-content-center">
          <div>
            <h6 class="title font-weight-bold ml-1 ml-md-4">
              {% if content.url %}
                <a href="{{ content.url }}">{{ content.studyType }}</a>
              {% else %}
                {{ content.studyType }}
              {% endif %}
            </h6>

            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">
              {{ content.institution }}
            </h6>

            {% if content.score %}
              <h6 class="ml-1 ml-md-4" style="font-size: 0.9rem;">
                {{ content.score }}
              </h6>
            {% endif %}

            {% if content.area %}
              <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">
                {{ content.area }}
              </h6>
            {% endif %}

            {% if content.courses and content.courses.size > 0 %}
              <ul class="items">
                {% for item in content.courses %}
                  <li>
                    <span class="item">{{ item }}</span>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </div>

      </div>
    </li>
  {% endfor %}
</ul>

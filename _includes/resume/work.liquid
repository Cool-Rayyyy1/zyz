<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign work = data[1] %}
  {% for content in work %}
    <li class="list-group-item">
      <div class="row">
        <!-- 左边：公司 logo + 时间 + 地点，结构跟 projects 一样 -->
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center cv-work-date-col">
          {% if content.logo %}
            <div class="cv-work-logo mb-2">
              <img src="{{ content.logo | relative_url }}" alt="{{ content.name }} logo">
            </div>
          {% endif %}

          {% if content.startDate %}
            {% assign startDate = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
            {% assign endDate = content.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
            {% assign date = startDate | append: ' - ' | append: endDate %}

            <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
              {{ date }}
            </span>
          {% endif %}

          {% if content.location %}
            <p class="location mt-1 mb-0">
              <i class="fa-solid fa-location-dot iconlocation"></i>
              {{ content.location }}
            </p>
          {% endif %}
        </div>

        <!-- 右边：职位 + 公司名 + summary + highlights -->
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {{ content.position }}
          </h6>

          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem;">
            {{ content.name }}
          </h6>

          {% if content.summary %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem;">
              {{ content.summary }}
            </h6>
          {% endif %}

          {% if content.highlights and content.highlights.size > 0 %}
            <ul class="items">
              {% for item in content.highlights %}
                <li>
                  <span class="item">{{ item }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
